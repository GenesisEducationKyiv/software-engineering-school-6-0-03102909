{
  "name": "github-release-notification-api",
  "version": "1.0.0",
  "description": "GitHub Release Notification API that allows users to subscribe to email notifications about new releases of a chosen GitHub repository.",
  "homepage": "https://github.com/03102909/github-release-notification-api#readme",
  "bugs": {
    "url": "https://github.com/03102909/github-release-notification-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/03102909/github-release-notification-api.git"
  },
  "license": "ISC",
  "author": "Sofiia Perkova",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "api": "npm run start --workspace=@github-release-notification/api",
    "api:dev": "npm run dev --workspace=@github-release-notification/api",
    "notification": "npm run start --workspace=@github-release-notification/notification",
    "notification:dev": "npm run dev --workspace=@github-release-notification/notification",
    "build": "npm run build -w @github-release-notification/shared && npm run build -w @github-release-notification/api && npm run build -w @github-release-notification/notification",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "ts-proto": "^2.11.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "axios": "^1.15.0",
    "croner": "^10.0.1",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "redis": "^5.11.0",
    "resend": "^6.10.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  }
}
